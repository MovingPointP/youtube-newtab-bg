{
  "manifest_version": 3,
  "name": "Lumelo",
  "version": "0.0.2",
  "description": "新しいタブの背景で YouTube 動画を再生できるか確かめるための最小構成",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": ["declarativeNetRequest", "storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*"]
}
